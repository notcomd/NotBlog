# unpacked plugin folders
plugins/**/*

# files directory where uploads go（仅匹配仓库根目录；勿用裸 "files"，会误伤 Commands/Files、Queries/Files 等代码目录）
/files

# DBMigrate plugin: generated SQL
db/sql

# AssetBundler plugin: generated bundles
javascripts/bundles
stylesheets/bundles
/.vs/MyService/FileContentIndex/31ba432c-50fe-47c3-817c-b9c40dc91d73.vsidx
/.vs
bin/
obj/
.trae/

# ===== 凭据与敏感配置（S-01 密钥治理） =====
# 环境变量文件（docker-compose 等读取的本地凭据，勿提交）
*.env
.env

# 生产环境 appsettings（含真实密钥/口令）
appsettings.Production.json
appsettings.*.Production.json

# dotnet user-secrets：本地开发密钥保存在 %APPDATA%\Microsoft\UserSecrets\<userSecretsId>\secrets.json，
# 由 SDK 管理、不入库；若项目目录内出现 secrets.json 同样忽略
secrets.json

# Rider/ReSharper IDE 本地配置（dataSources.xml 等可能含本地数据库口令）
.idea/

# 测试结果目录
TestResults/
*.trx

# Aspire 部署工件（docker-compose.yaml / .env 等生成物，由 aspire publish 重新生成）
aspire-output/

# Yarp 网关权限映射运行时缓存（PermissionMappingStore 本地 JSON 回退，启动后自动生成）
NotBlog_Yarp/permission-mappings.json

# 运行时调试日志
debug.log
