{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // JWT 配置与 Identity 服务保持一致（Issuer/Audience/算法/校验参数全站统一），
  // 签名密钥不落盘：从环境变量 JWT_PRIVATE_KEY 读取（凭据外置 S-01）
  "JwtOptions": {
    "Issuer": "email.notcomd@nmail.com",
    "Audiences": "email.notcomd@nmail.com",
    "ExpireSeconds": 3600,
    "ClockSkewSeconds": 5,
    "Algorithm": "HS384",
    "RefreshTokenExpireSeconds": 604800,
    "ValidateAudience": true,
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "BlacklistCapacity": 100000
  },
  "ConnectionStrings": {
    "MarkDownPostgres": "Host=localhost;Database=markdown_db;Username=notcomd"
  },
  "EventBus": {
    "SubscriptionClientName": "markdown_queue",
    "HostName": "localhost",
    "ExchangeName": "markdown_events",
    "ExchangeType": "Direct",
    "UserName": "guest",
    "Password": "guest"
  }
}
