{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtOptions": {
    "Issuer": "email.notcomd@nmail.com",
    "Audiences": "email.notcomd@nmail.com",
    "ExpireSeconds": 3600,
    "ClockSkewSeconds": 5,
    "Algorithm": "HS384",
    "RefreshTokenExpireSeconds": 604800,
    "ValidateAudience": true,
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "BlacklistCapacity": 100000
  },
  "DbContextOption": {
    "DbContextConnection": "Host=localhost;Database=markdownpostgres;Port=5432;Username=postgres;Password=postgres"
  },
  "EventBus": {
    "SubscriptionClientName": "markdown_queue",
    "HostName": "localhost",
    "ExchangeName": "notcomd_event_bus",
    "ExchangeType": "Direct",
    "UserName": "guest",
    "Password": "guest"
  }
}
