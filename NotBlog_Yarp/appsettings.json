{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "BlogIdentity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "{**catch-all}"          
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "pessimistic": {
            "Address": "https://localhost:9091"
          }
        }
      }
    }
  }
}
