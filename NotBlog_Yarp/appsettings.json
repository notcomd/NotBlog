{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information",
      "NotBlog_Yarp": "Debug"
    }
  },

  "JwtSettings": {
