    "BypassPaths": [],
    "Mappings": [
      { "Method": "GET",    "Path": "/api/tweets/{**catch-all}",     "Code": "api:tweet:read" },
      { "Method": "POST",   "Path": "/api/tweets/{**catch-all}",     "Code": "api:tweet:create" },
      { "Method": "PUT",    "Path": "/api/tweets/{**catch-all}",     "Code": "api:tweet:update" },
      { "Method": "DELETE", "Path": "/api/tweets/{**catch-all}",     "Code": "api:tweet:delete" },
      { "Method": "GET",    "Path": "/api/sessions/{**catch-all}",   "Code": "api:session:read" },
      { "Method": "POST",   "Path": "/api/sessions/{**catch-all}",   "Code": "api:session:create" },
      { "Method": "GET",    "Path": "/api/filestorage/{**catch-all}","Code": "api:file:read" },
      { "Method": "POST",   "Path": "/api/filestorage/{**catch-all}","Code": "api:file:create" },
      { "Method": "DELETE", "Path": "/api/filestorage/{**catch-all}","Code": "api:file:delete" },
      { "Method": "GET",    "Path": "/api/markdown/{**catch-all}",   "Code": "api:markdown:read" },
      { "Method": "POST",   "Path": "/api/markdown/{**catch-all}",   "Code": "api:markdown:create" },
      { "Method": "PUT",    "Path": "/api/markdown/{**catch-all}",   "Code": "api:markdown:update" },
      { "Method": "DELETE", "Path": "/api/markdown/{**catch-all}",   "Code": "api:markdown:delete" },
      { "Method": "GET",    "Path": "/api/identity/{**catch-all}",   "Code": "api:identity:read" },
      { "Method": "POST",   "Path": "/api/identity/{**catch-all}",   "Code": "api:identity:manage" }
    ],
    "DevUsers": {
      "00000000-0000-0000-0000-000000000001": {
        "Permissions": [
          "api:tweet:read", "api:tweet:create", "api:tweet:update", "api:tweet:delete",
          "api:session:read", "api:session:create",
          "api:file:read", "api:file:create", "api:file:delete",
          "api:markdown:read", "api:markdown:create", "api:markdown:update", "api:markdown:delete",
          "api:identity:read", "api:identity:manage"
        ],
        "DataScope": "2|"
      }
    }
