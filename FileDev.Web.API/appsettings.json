{
  "JwtOptions": {
    "Issuer": "email.notcomd@nmail.com",
    "Audiences": "email.notcomd@nmail.com",
    "ExpireSeconds": 3600,
    "Algorithm": "HS384",
    "ClockSkewSeconds": 5
  },
  "EventBus": {
    "SubscriptionClientName": "filedev_events",
    "HostName": "127.0.0.1",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "notcomd_event_bus",
    "ExchangeType": "Direct",
    "RetryCount": 5,
    "PrefetchCount": 10,
    "MaxConcurrency": 4
  },
  "DbContextOption": {
    "DbContextConnection": "Host=localhost;Database=notfilepostgres;Port=5432;Username=postgres;Password=postgres;"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://127.0.0.1:27017",
    "Database": "notfile"
  },
  "NotFileStorage": {
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".webp",
      ".ico",
      ".mp4",
      ".avi",
      ".mkv",
      ".mov",
      ".wmv",
      ".flv",
      ".webm",
      ".mp3",
      ".wav",
      ".ogg",
      ".flac",
      ".aac",
      ".wma",
      ".m4a",
      ".zip",
      ".rar",
      ".7z",
      ".tar",
      ".gz",
      ".bz2",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".txt",
      ".md",
      ".csv",
      ".json",
      ".xml"
    ],
    "ChunkFileSize": 5242880,
    "MaxFileSize": 10737418240,
    "StoragePath": "FileStorage",
    "TempPath": "temp_chunks",
    "ChunkExpirationHours": 24,
    "UserStorageQuota": 53687091200
  },
  "LiteStorage": {
    "RootPath": "FileStorage/lite",
    "ChunkSize": 5242880,
    "DirectoryLimits": {
      "MaxObjects": 0,
      "MaxBytes": 0
    },
    "PersistIndex": true,
    "LogLevel": "Info",
    "LogToConsole": false,
    "LogToFile": true,
    "LogFilePath": "FileStorage/lite/logs/lite.log",
    "Storage": {
      "DataDirectories": [],
      "EnableDeduplication": true,
      "AutoGrow": true,
      "AutoGrowBasePath": "FileStorage/lite/growth",
      "MaxBytesPerVolume": 0,
      "ReadCacheMaxBytesPerVolume": 268435456,
      "ReadCacheMaxEntriesPerVolume": 4096,
      "VolumeIsolation": "Shared",
      "TenantDataDirectories": {},
      "TenantMaxBytesPerVolume": {}
    },
    "Lifecycle": {
      "Enabled": true,
      "ExpireScanInterval": "01:00:00",
      "TierScanInterval": "12:00:00",
      "ColdThreshold": "30.00:00:00"
    }
  }
}
