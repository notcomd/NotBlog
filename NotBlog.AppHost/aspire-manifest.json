      "image": "docker.io/library/redis:8.6",
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "redis-server --requirepass $REDIS_PASSWORD --save 60 1"
      ],
      "volumes": [
        {
          "name": "notblog.apphost-4e335c671b-Redis-data",
          "target": "/data",
          "readOnly": false
        }
      ],
      "env": {
