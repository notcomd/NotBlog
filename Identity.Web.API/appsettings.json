{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SmsCode": {
    "Enabled": false
  },
  "FileStorageGrpc": {
    "Address": "https://localhost:5002"
  },
